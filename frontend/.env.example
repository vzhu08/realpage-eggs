# Copy to .env.local for local overrides. Nothing here is secret.

# Where the dev/preview server proxies /api (default http://127.0.0.1:8000).
# The synthetic backend from docs/FRONTEND_HANDOFF.md runs on :8001.
NAVIGATOR_API_ORIGIN=http://127.0.0.1:8000

# Base URL the browser calls. Default "/api/v1" (same origin, via the proxy above).
# Set an absolute URL only for a static deployment; that origin must allow CORS.
VITE_API_BASE_URL=/api/v1

# Starting data mode: "live" (default) or "demo" (labeled synthetic replay).
VITE_DATA_MODE=live
