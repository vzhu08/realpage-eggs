# Explicit allowlist: no .env, private data, caches, input pack or Git history in build context.
**
!requirements.lock
!navigator/
!navigator/*.py
!config/
!config/test_rule_selectors.json
!contracts/
!contracts/**/*.json
!fixtures/
!fixtures/synthetic_ordinance.txt
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/playwright.config.ts
!frontend/src/
!frontend/src/**
!frontend/scripts/
!frontend/scripts/generate-contract-types.mjs
!frontend/tests/
!frontend/tests/**/*.ts
!deploy/
!deploy/Dockerfile
!scripts/
!scripts/platform_ops.py
!scripts/render_snapshot.py
**/__pycache__/
**/*.pyc
**/.env*
**/node_modules/
**/dist/
**/.git/
